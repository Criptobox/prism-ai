# Prism AI — configuración de entorno (OPCIONAL)
# ---------------------------------------------------------------
# La app funciona 100% en el navegador: tus claves API (AiHubMix,
# Gemini, Groq, OpenRouter…) se pegan en Ajustes → Proveedores y se
# guardan únicamente en tu dispositivo. NO necesitas ninguna clave
# de servidor para ejecutar Prism AI.

# Base de datos local (solo utilidades de servidor opcionales)
DATABASE_URL=file:./db/custom.db
